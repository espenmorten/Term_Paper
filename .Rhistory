install.packages("haven") # Install package that can read stata files (.dta)
install.packages("estimatr")
install.packages("labelled")
install.packages("tidyverse")
install.packages("rddensity")
install.packages("rdrobust")
install.packages("modelsummary")
install.packages("gghighlight")
install.packages("scales")
library(tidyverse)
library(estimatr)
library(haven)
library(labelled)
library(rddensity)
library(rdrobust)
library(modelsummary)
library(gghighlight)
library(scales)
elections = read_dta(file.choose())
dictionary <- look_for(elections)
View(dictionary)
data <- read_dta("data/regdata0.dta")
nrow(data)
ncol(data)
x <- data$iwm94 # x is the running variable, access the specific column iwm94 with "$"
d <- data$i94 #d is the assignment status, access specific column i94 with $.
y <- data$hischshr1520f #y is the outcome, and we access the outcome for high school education for females ages 15-20.
summary(y)
complete_data <- data[complete.cases(x, d, y, data$ageshr19),]
# sum(complete_data) #Why do we not get 2629, as in the paper?
# grep("age", names(data), value = TRUE) THIS ONE NEEDS VERIFICATION
# sum(is.na(data$ageshr19) & ok)
#MAKE TABLE 1
#Covariates: vshr_islam1994, partycount, lpop1994, ageshr19, ageshr60, sexr, shhs, merkezi, merkezp, subbuyuk
#DENSITY FUNCTION (figure 2):
density_test <- rddensity(complete_data$iwm94, c=0)
summary(density_test)
rdplotdensity(rdd=density_test,
X=complete_data$iwm94,
type="both")
ggplot(complete_data, aes(x=vshr_islam1994, y=vi1)) +
geom_point(color=ifelse(abs(complete_data$vi1)<=0.02, "black", "azure4")) +
xlim(0, 0.75) +
labs(x="Islamic vote share", y="Islamic win margin") +
geom_abline(intercept=-1, slope=2, color="black") +
geom_abline(intercept=0, slope=0, color="azure3") +
theme_classic()
#FIGURE 2
ggplot(complete_data, aes(x=vi1, y=after_stat(100*count/sum(count)))) +
geom_histogram(binwidth = 0.02, fill = "azure4", color="black")+
scale_y_continuous(labels=percent) +
xlim(-1, 1) +
labs(x="Islamic win margin", y="Percent") +
geom_vline(xintercept = 0, linetype = "dashed")+
theme_classic()
ggplot(complete_data, aes(x=vi1, y=after_stat(count/sum(count)))) +
geom_histogram(binwidth = 0.02, fill = "azure4", color="black")+
scale_y_continuous(labels=percent) +
xlim(-1, 1) +
labs(x="Islamic win margin", y="Percent") +
geom_vline(xintercept = 0, linetype = "dashed")+
theme_classic()
