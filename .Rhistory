type="both",
plotRange = c(-0.5, 0.5),
hist=FALSE)
density_data <- rdd_data(x=complete_data$iwm94, cutpoint=0)
density_data <- rdd_data(y, x=complete_data$iwm94, cutpoint=0)
density_data <- rdd_data(y=after_stat(count/sum(count)), x=complete_data$iwm94, cutpoint=0)
density_data <- rdd_data(y=complete_data$hischshr1520f, x=complete_data$iwm94, cutpoint=0)
test_density <- dens_test(density_data)
rdplotdensity(rdd=test_density,
X=complete_data$iwm94,
type="both",
plotRange = c(-0.5, 0.5),
hist=FALSE)
